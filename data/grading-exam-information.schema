{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shorinjikempo.example/schemas/grading-exam-information.json",
  "title": "GradingExamInformation",
  "description": "Dictionary of grading-test descriptions keyed by GradeName (e.g. '6 kyū', 'shodan'). Each value describes the curriculum/grading-test content for a single Shorinji Kempo grade. User-visible Swedish strings are looked up in src/assets/translations.json at runtime; romaji keys are used to look up kanji in the 'ja' section of translations.json.",
  "type": "object",
  "additionalProperties": { "$ref": "#/definitions/GradeManual" },
  "definitions": {
    "GradeManual": {
      "type": "object",
      "required": ["title", "sections"],
      "properties": {
        "term": {
          "$ref": "#/definitions/Term",
          "description": "Original Japanese title of the document (romaji), e.g. 'rokkyū shōkyū kōshi jisshi yōmoku'. Kanji is looked up via translations.json."
        },
        "title": {
          "type": "string",
          "description": "User-visible document title in Swedish. Used as the lookup key into translations.json for ja/en/tr."
        },
        "sections": {
          "type": "array",
          "items": { "$ref": "#/definitions/Section" }
        }
      }
    },
    "Term": {
      "description": "A Shorinji Kempo terminology unit. Romaji is the canonical key; kanji is looked up from the 'ja' section of translations.json at render time. Only the optional 'gloss' is translatable.",
      "type": "object",
      "required": ["romaji"],
      "properties": {
        "romaji": {
          "type": "string",
          "description": "Hepburn romanization. Also serves as the translations.json lookup key for kanji (ja section)."
        },
        "gloss": {
          "type": "string",
          "description": "Optional short Swedish explanation shown in parentheses after the romaji, e.g. 'klädsel'. Looked up in translations.json."
        }
      }
    },
    "Numbering": {
      "description": "How the item is labelled in the printed source. The renderer decides the visual style; 'value' is the sequential number within its parent.",
      "type": "object",
      "required": ["style"],
      "properties": {
        "style": {
          "type": "string",
          "enum": ["bullet", "numeric", "paren", "circled"],
          "description": "bullet = '・'; numeric = '1.'; paren = '(1)'; circled = '①'."
        },
        "value": {
          "type": "integer",
          "minimum": 1,
          "description": "Sequential number within siblings. Omit for bullets."
        }
      }
    },
    "Annotation": {
      "description": "A note attached to an item, shown beneath it. The Japanese source uses ※ (kome); the Swedish translation uses *.",
      "type": "object",
      "required": ["text"],
      "properties": {
        "marker": {
          "type": "string",
          "enum": ["kome", "asterisk"],
          "default": "kome"
        },
        "text": {
          "type": "string",
          "description": "Annotation text in Swedish. Looked up in translations.json."
        }
      }
    },
    "Video": {
      "description": "A link to a demonstration video. 'label' distinguishes multiple videos for the same item (e.g. a variation); omit it when there is a single video. The UI prefixes the translated word 'Video'.",
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Full URL to the video, e.g. a YouTube watch URL."
        },
        "label": {
          "type": "string",
          "description": "Optional short variation label shown after 'Video - ', e.g. 'nage'. Romaji, not translated."
        }
      }
    },
    "TechniqueGroup": {
      "description": "A list of Japanese techniques sharing a common context (stance, direction, etc.). The context is rendered in parentheses before the list, e.g. '(開足立から) / (från kaisoku dachi)'.",
      "type": "object",
      "required": ["techniques"],
      "properties": {
        "context": {
          "type": "object",
          "description": "Optional shared context. 'text' is a Swedish string looked up in translations.json; Japanese form is retrieved from the 'ja' section using 'text' as key.",
          "properties": {
            "text": { "type": "string" }
          }
        },
        "techniques": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/Term" }
        }
      }
    },
    "Section": {
      "description": "A top-level subdivision of the manual, typically marked '◎' in the source.",
      "type": "object",
      "required": ["title", "items"],
      "properties": {
        "marker": {
          "type": "string",
          "description": "Visual marker in the source, e.g. '◎'."
        },
        "term": {
          "$ref": "#/definitions/Term",
          "description": "Japanese name of the section, e.g. '学科科目' / 'gakka kamoku'."
        },
        "title": {
          "type": "string",
          "description": "Swedish section title, e.g. 'teoretiska ämnen'. Looked up in translations.json."
        },
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/Item" }
        }
      }
    },
    "Item": {
      "description": "Generic recursive node. Represents a numbered or bulleted entry with optional Japanese term, translatable description, point value, annotations, technique groups, and nested sub-items.",
      "type": "object",
      "properties": {
        "numbering": { "$ref": "#/definitions/Numbering" },
        "term": { "$ref": "#/definitions/Term" },
        "text": {
          "type": "string",
          "description": "Swedish prose used when an item's main content is descriptive rather than a Japanese term. Looked up in translations.json."
        },
        "description": {
          "type": "string",
          "description": "Secondary Swedish explanation shown beneath an item (e.g. how a test is structured, what gets selected). Distinct from 'text' (the item's main content) and 'annotations' (※/* notes). Looked up in translations.json."
        },
        "points": {
          "type": "integer",
          "minimum": 0,
          "description": "Point value (X 点 / X poäng)."
        },
        "annotations": {
          "type": "array",
          "items": { "$ref": "#/definitions/Annotation" }
        },
        "techniqueGroups": {
          "type": "array",
          "items": { "$ref": "#/definitions/TechniqueGroup" }
        },
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/Item" }
        },
        "videos": {
          "type": "array",
          "items": { "$ref": "#/definitions/Video" }
        }
      }
    }
  }
}

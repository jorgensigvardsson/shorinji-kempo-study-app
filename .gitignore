# Local docker-compose environment — copy to .env and fill in values
.env
node_modules

# Local dev data: signing key, user/org files, documents — bind-mounted by
# docker-compose.yml so it's inspectable on the host. See backend/auth/cmd/devseed.
/devdata/

# Local backend development server output
backend/*/.dev.*.log
.codex/*.log

# The dev certificate (localhost.pem / localhost.key) is deliberately NOT
# ignored: it secures nothing, and committing it is what makes the stack work
# on a fresh clone. See infrastructure/scripts/gen-dev-cert.sh.

# Personal Claude Code settings: machine-specific paths and permission grants.
# The shared .claude/settings.json stays tracked.
.claude/settings.local.json

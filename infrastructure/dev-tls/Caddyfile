# TLS termination for local HTTPS development, used only by
# docker-compose.https.yml. Caddy listens on the same three ports the base
# compose file would otherwise publish and forwards to the app containers,
# which keep speaking plain HTTP. Websocket upgrades (Vite HMR) pass through
# reverse_proxy untouched.
#
# auto_https is off because the cert is supplied explicitly — a self-signed
# one from infrastructure/scripts/gen-dev-cert.sh — and there is no public
# domain to provision anything for.

{
	auto_https off
	admin off
}

(dev_tls) {
	tls /etc/caddy/certs/dev.crt /etc/caddy/certs/dev.key
}

:5173 {
	import dev_tls
	reverse_proxy frontend:5173
}

:8081 {
	import dev_tls
	reverse_proxy auth:8081
}

:8080 {
	import dev_tls
	reverse_proxy persistence:8080
}

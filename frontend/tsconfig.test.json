{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    /* vite-plugin-pwa declares `virtual:pwa-register/react`, which App and the update
       hook import. src/vite-env.d.ts carries this for the app project, but that file
       is not in this project's include list — only test entry points are — so the
       reference has to be repeated here for anything reaching those modules. */
    /* "node" because a couple of tests read a source file off disk rather than
       importing it — a stylesheet cannot be pulled in with ?raw, since Vite's CSS
       pipeline claims the request first. */
    "types": ["vite/client", "vite-plugin-pwa/client", "node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  /* Only the test entry points: the components and modules they exercise are
     pulled in as imports, and are type-checked by tsconfig.app.json in their
     own right. Vitest and Testing Library are imported explicitly rather than
     relied on as globals, so no extra "types" entry is needed for them. */
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test-setup.ts"]
}

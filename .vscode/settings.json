{
  // Remote-SSH port forwarding for the docker compose stack. The HTTPS overlay
  // (docker-compose.https.yml) puts Caddy on these ports serving TLS, so they
  // must be forwarded as https — otherwise VS Code probes them as http, the
  // probe fails against the TLS listener, and generated links use the wrong
  // scheme. Harmless when running the plain-HTTP base stack: the label is just
  // slightly wrong.
  "remote.autoForwardPortsSource": "hybrid",
  "remote.portsAttributes": {
    "5173": { "label": "frontend", "protocol": "https", "onAutoForward": "silent" },
    "8081": { "label": "auth", "protocol": "https", "onAutoForward": "silent" },
    "8080": { "label": "persistence", "protocol": "https", "onAutoForward": "silent" }
  }
}

{
  // Remote-SSH port forwarding for the docker compose stack. nginx is the only
  // published port and it serves TLS, so it must be forwarded as https —
  // otherwise VS Code probes it as http, the probe fails against the TLS
  // listener, and generated links use the wrong scheme.
  "remote.autoForwardPortsSource": "hybrid",
  "remote.portsAttributes": {
    "5173": { "label": "app (nginx)", "protocol": "https", "onAutoForward": "silent" }
  }
}
